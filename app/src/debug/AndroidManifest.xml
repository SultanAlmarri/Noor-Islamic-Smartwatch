<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (never in the release APKs given to users): a hook that lets the on-device alert test set Noor up
     and read its alert history from the command line. Only the shell (adb) holds the DUMP permission that guards it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug only: lets the emulator test switch the phone's language (granted by adb; a development permission). -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <application>
        <!-- Debug only: Noor's widgets hosted as a launcher hosts them, for tools/devicetest/widgets.sh. -->
        <activity
            android:name="com.noor.app.debug.WidgetHostActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver
            android:name="com.noor.app.debug.TestHookReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.noor.smartwatch.debug.SETUP" />
                <action android:name="com.noor.smartwatch.debug.DUMP" />
                <action android:name="com.noor.smartwatch.debug.CITY" />
                <action android:name="com.noor.smartwatch.debug.STATUS" />
                <action android:name="com.noor.smartwatch.debug.LANG" />
                <action android:name="com.noor.smartwatch.debug.SYSTEM_LOCALE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
