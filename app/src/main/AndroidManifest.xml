<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location. Android lets the user choose precise or approximate; Noor works with either. Precise gives the
         neighbourhood name and the best Qibla bearing; approximate names the town. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only for official open-data timetables (e.g. MUIS on data.gov.sg); prayer times never need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: lets the low-frequency background refresh run when the app is closed (asked separately, with an explanation). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The Adhan screen over the lock screen while the Adhan plays, as an alarm clock does. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 0.22: the prayer countdown as a chip in the status bar (Android 16's Live Updates; a normal permission, and the
         user can turn it off for Minhad in Android's settings). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 0.22.4: the countdown keeps ticking when Minhad is closed (StatusCountdownService, a foreground service of the
         "special use" type while Minhad writes the countdown itself; docs/HANDOVER.md section 37). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".NoorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Noor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Noor.Splash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Adhan screen, over the lock screen while the Adhan plays. -->
        <activity
            android:name=".adhan.AdhanAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.noor.smartwatch.adhan"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Noor" />

        <!-- 0.22, Direct Boot: the prayer alarms work after a restart before the phone is first unlocked (Samsung phones
             restart themselves at night). Only the alarm path runs then: the boot receiver (LOCKED_BOOT_COMPLETED), the
             alarm receiver and the Adhan service, from the copy of the times kept in device-protected storage
             (docs/ALERTS.md, "Never twice, never lost, and before the first unlock"). The watch's manifest is unchanged. -->
        <receiver android:name="com.noor.alerts.SystemEventsReceiver" android:directBootAware="true" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.noor.alerts.AlertReceiver" android:directBootAware="true" tools:node="merge" />
        <service android:name="com.noor.alerts.AdhanService" android:directBootAware="true" tools:node="merge" />

        <!-- Recalculate for the new zone when the user travels or changes the clock. -->
        <receiver android:name=".data.TimeChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- The persistent prayer notification: its own update times, restarts, app updates, clock, zone and language. -->
        <receiver android:name=".notify.StatusRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.noor.app.STATUS_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 0.24.1: tells One UI that Minhad's ongoing notification can be a Live Notification (its own card, used only in
             the tester's "Samsung live card" experiment for the status-bar timer's icon slot; One UI shows it only for the
             apps it lists). -->
        <meta-data android:name="com.samsung.android.support.ongoing_activity" android:value="true" />

        <!-- 0.22.4: holds the persistent notification while Minhad writes its countdown (the phone's digits differ from
             the app's, or the status-bar chip), so it keeps ticking when the app is closed. Not stopped with the task. -->
        <service
            android:name=".notify.StatusCountdownService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live countdown to the next prayer in the status bar and notification, chosen by the user" />
        </service>

        <!-- Home-screen widgets (0.9.10). -->
        <receiver android:name=".widget.NextPrayerWidget" android:exported="true" android:label="@string/widget_next_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver android:name=".widget.TodayWidget" android:exported="true" android:label="@string/widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".widget.SkyWidget" android:exported="true" android:label="@string/widget_sky_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sky_info" />
        </receiver>
        <receiver android:name=".widget.RingWidget" android:exported="true" android:label="@string/widget_ring_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ring_info" />
        </receiver>
        <receiver android:name=".widget.StripWidget" android:exported="true" android:label="@string/widget_strip_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_strip_info" />
        </receiver>
        <receiver android:name=".widget.DateWidget" android:exported="true" android:label="@string/widget_date_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_date_info" />
        </receiver>
        <!-- (0.23) A widget's settings: opened by the home screen (placing or long-pressing a widget). -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Noor">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- The widgets' own update times, restarts, app updates, clock, zone and language. -->
        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.noor.app.WIDGET_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Answers "Sync with phone" on the watch by publishing the settings again. -->
        <service
            android:name=".data.WatchRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/noor/sync-request" />
            </intent-filter>
        </service>

        <!-- Per-app language on Android 12 and below (AppCompat stores the choice). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
    </application>
</manifest>
