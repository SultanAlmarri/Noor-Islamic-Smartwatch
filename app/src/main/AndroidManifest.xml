<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location. Android lets the user choose precise or approximate; Noor works with either. Precise gives the
         neighbourhood name and the best Qibla bearing; approximate names the town. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only for official open-data timetables (e.g. MUIS on data.gov.sg); prayer times never need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: lets the low-frequency background refresh run when the app is closed (asked separately, with an explanation). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- The Adhan screen over the lock screen while the Adhan plays, as an alarm clock does. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".NoorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Noor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Noor.Splash"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Adhan screen, over the lock screen while the Adhan plays. -->
        <activity
            android:name=".adhan.AdhanAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.noor.smartwatch.adhan"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Noor" />

        <!-- Recalculate for the new zone when the user travels or changes the clock. -->
        <receiver android:name=".data.TimeChangeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- The persistent prayer notification: its own update times, restarts, app updates, clock, zone and language. -->
        <receiver android:name=".notify.StatusRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.noor.app.STATUS_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (0.9.10). -->
        <receiver android:name=".widget.NextPrayerWidget" android:exported="true" android:label="@string/widget_next_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver android:name=".widget.TodayWidget" android:exported="true" android:label="@string/widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver android:name=".widget.SkyWidget" android:exported="true" android:label="@string/widget_sky_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sky_info" />
        </receiver>
        <!-- The widgets' own update times, restarts, app updates, clock, zone and language. -->
        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.noor.app.WIDGET_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Answers "Sync with phone" on the watch by publishing the settings again. -->
        <service
            android:name=".data.WatchRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/noor/sync-request" />
            </intent-filter>
        </service>

        <!-- Per-app language on Android 12 and below (AppCompat stores the choice). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
    </application>
</manifest>
