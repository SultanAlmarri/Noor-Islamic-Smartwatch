<?xml version="1.0" encoding="utf-8"?>
<!-- (0.23) Darkens a small widget's sky picture evenly, a little more at the foot, so its countdown reads over bright
     sand or snow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#4D000000" android:centerColor="#40000000" android:endColor="#73000000" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
