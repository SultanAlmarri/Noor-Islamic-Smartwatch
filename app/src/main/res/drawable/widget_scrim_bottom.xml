<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the lower part of a widget's sky picture so the prayer times written over the land stay readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#40000000" android:endColor="#99000000" />
    <corners android:radius="22dp" />
</shape>
