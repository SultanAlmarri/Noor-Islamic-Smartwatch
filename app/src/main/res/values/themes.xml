<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Noor" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/night_900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Noor.Splash" parent="Theme.SplashScreen">
        <!-- The dusk the home screen's sky waits in (RealSky.WAITING_SKY): the opening goes on from this colour without a cut. -->
        <item name="windowSplashScreenBackground">@color/noor_dusk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Noor</item>
    </style>
</resources>
