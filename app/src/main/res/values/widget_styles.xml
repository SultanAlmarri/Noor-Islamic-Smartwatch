<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widgets' text (0.9.10): white over the sky picture, with a soft shadow so it reads over bright
     clouds and the low Sun. -->
<resources>
    <style name="Theme.Noor.Widget" parent="android:Theme.DeviceDefault" />

    <style name="Widget.Noor.Text" parent="">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:shadowColor">#73000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="Widget.Noor.Text.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Noor.Text.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
    </style>

    <style name="Widget.Noor.Text.Small">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#D9FFFFFF</item>
    </style>

    <style name="Widget.Noor.Text.Time">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- The countdown: the app's own Plex Arabic Light (its digits are all one width), set tight as on the home screen. -->
    <style name="Widget.Noor.Text.Countdown">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:layoutDirection">ltr</item>
    </style>
</resources>
