// Noor home sky: the sky of the moment (from the precomputed atmosphere table), the Sun, the moon, stars and the
// Milky Way, high cirrus and distant cloud banks. Rendered at reduced resolution into a cached layer (everything here is
// soft); see ShaderSky.kt for the uniforms. The clouds themselves are drawn over it as pictures (CloudField.kt, 0.9.9).

uniform float2 uSize;      // layer size, px
uniform float uDp;         // layer px per dp
uniform float uHorizon;    // y of the horizon, px
uniform float uAltTop;     // view altitude at the top edge, degrees
uniform float uAltPow;     // screen-to-altitude curve
uniform float uFov;        // horizontal field of view, radians
uniform float2 uLutSize;   // atmosphere table size (columns, rows)
uniform float uLutPow;     // the table's altitude curve
uniform float2 uSunPos;    // where the Sun is drawn, px
uniform float3 uSunDir;    // direction of the drawn Sun (view space)
uniform float uSunEl;      // the Sun's true elevation, degrees
uniform float3 uSunDisc;   // radiance of the disc (exposed, linear; refraction included)
uniform float3 uSunGlow;   // glare round it
uniform float3 uSunCloud;  // sunlight at the cumulus (exposed, linear)
uniform float3 uSunHigh;   // sunlight at the cirrus
uniform float3 uAmbTop;    // skylight from above
uniform float3 uAmbLow;    // skylight from the horizon
uniform float uNight;      // 0 day … 1 night: stars
uniform float uTime;       // seconds, ambient clock
uniform float4 uWeather;   // cumulus cover, cirrus, seed x, seed y
uniform float uCloudTop;   // clouds keep below this y (the text above), px
uniform float4 uMoon;      // x, y (px), radius (px), visibility
uniform float3 uMoonLight; // direction of sunlight on the moon (moon frame)
uniform float uMilky;      // Milky Way strength
uniform float uWind;       // drift of the clouds so far, km
uniform float uTextBottom; // the text written on the sky ends here, px
// The real night sky (0.9.8), in view space: the celestial axes (the faint stars turn with them), the galactic pole and
// centre (the Milky Way), how much of the moon is lit, and the bright stars of the catalogue drawn into starAt().
uniform float3 uCelX;
uniform float3 uCelY;
uniform float3 uCelZ;
uniform float3 uGalN;
uniform float3 uGalC;
uniform float uMoonIllum;

float altAt(float y) {
    float t = sat((uHorizon - y) / uHorizon);
    return uAltTop * pow(t, uAltPow);
}

float3 viewDir(float2 fc) {
    float az = (fc.x / uSize.x - 0.5) * uFov;
    float alt = radians(max(altAt(fc.y), 0.0));
    return float3(cos(alt) * sin(az), sin(alt), cos(alt) * cos(az));
}

float3 skyAt(float x, float altDeg) {
    float v = pow(sat(altDeg / 90.0), 1.0 / uLutPow);
    float2 p = float2(sat(x / uSize.x) * (uLutSize.x - 1.0) + 0.5, v * (uLutSize.y - 1.0) + 0.5);
    return lutAt(p).rgb;
}

// The faint stars (0.9.8): thousands, fixed on the celestial sphere so they turn with the night, many faint and few
// bright; they twinkle more near the horizon, where the air is thick, and fade there; a bright moon washes the faintest out.
float3 faintStars(float3 v, float alt, float moonWash) {
    float3 c = float3(dot(v, uCelX), dot(v, uCelY), dot(v, uCelZ));
    float pxPerRad = uSize.x / uFov;
    float3 acc = float3(0.0);
    for (int k = 0; k < 2; k++) {
        float K = k == 0 ? 150.0 : 70.0;
        float3 g = c * K + (k == 0 ? float3(0.0) : float3(17.3, 5.1, 9.7));
        float3 id = floor(g);
        float pick = hash12(id.xy + id.z * 7.31);
        float keep = k == 0 ? 0.30 : 0.10;
        if (pick < keep) {
            float3 h = float3(hash12(id.xy * 1.7 + id.z), hash12(id.yz * 2.3 + id.x), hash12(id.zx * 0.9 + id.y));
            float3 sp = id + 0.25 + 0.5 * h;
            float dPx = length(g - sp) / K * pxPerRad / uDp;   // dp from the star
            float m = hash12(id.xy * 3.1 + id.z * 1.3);
            float b = k == 0 ? pow(m, 6.0) * 0.40 : pow(m, 4.0) * 0.55;
            float scint = 0.25 + 0.55 * (1.0 - smoothstep(10.0, 40.0, alt));
            float tw = 1.0 - scint * (0.5 + 0.5 * sin(uTime * (2.0 + 5.0 * h.x) + 6.283 * h.y));
            float r = k == 0 ? 0.40 : 0.5;
            float sh = exp(-dPx * dPx / (r * r)) * b * tw;
            float3 tint = mix(float3(0.78, 0.86, 1.0), float3(1.0, 0.88, 0.72), pow(hash12(id.xy + 1.9 + id.z), 1.5));
            acc += tint * sh * (1.0 - moonWash * (k == 0 ? 0.85 : 0.55));
        }
    }
    return acc * smoothstep(1.0, 14.0, alt);
}

// The Milky Way (0.9.8), where it really is: brightness from galactic latitude and longitude, brightest and widest
// towards the centre in Sagittarius, with star clouds, the Great Rift of dust along its middle and a warm central bulge.
float3 milkyWay(float3 v, float alt) {
    float sb = clamp(dot(v, uGalN), -1.0, 1.0);
    float b = asin(sb);
    float3 c0 = normalize(uGalC - uGalN * dot(uGalC, uGalN));
    float3 c1 = cross(uGalN, c0);
    float3 p = v - uGalN * sb;
    float l = atan(dot(p, c1), dot(p, c0));            // 0 at the centre, ±π opposite
    float lc = abs(l);
    float width = radians(6.0) + radians(8.0) * exp(-lc * lc / 0.9);
    float band = exp(-(b / width) * (b / width));
    float halo = exp(-abs(b) / radians(20.0));
    float bulge = exp(-(l * l / 0.05 + b * b / 0.02));
    float towardsCentre = 0.28 + 0.72 * exp(-lc * lc / 1.3);
    // Noise in even, undistorted coordinates along the band (degrees), so the star clouds are clumps, not swirls.
    float2 gq = float2(l * cos(b), b) * 57.3;
    float clouds = fbm4(gq * 0.11 + float2(3.0, 1.0), float4(1.0, 1.0, 0.8, 0.6));
    float fine = fbm4(gq * 0.35 + float2(7.0, 2.0), float4(1.0, 0.8, 0.6, 0.0));
    // The Great Rift: dark dust along the plane, from Cygnus to Sagittarius.
    float rift = smoothstep(0.46, 0.66, fbm4(gq * float2(0.06, 0.24) + float2(11.0, 4.0), float4(1.0, 1.0, 0.6, 0.0)))
        * exp(-(b / radians(4.0)) * (b / radians(4.0))) * (1.0 - smoothstep(1.2, 2.2, lc));
    float glow = (band * (0.35 + 0.9 * clouds * clouds + 0.3 * fine) + halo * 0.08) * towardsCentre * (1.0 - 0.85 * rift) + bulge * 1.2 * (1.0 - 0.5 * rift);
    float3 col = mix(float3(0.62, 0.70, 0.95), float3(1.0, 0.86, 0.68), sat(bulge * 1.5 + 0.25 * exp(-lc * lc / 0.6)));
    return col * glow * 0.20 * smoothstep(3.0, 20.0, alt);
}

// A shooting star now and then on a dark night: a short bright streak that fades as it falls.
float3 meteor(float2 fc) {
    float period = 23.0;
    float n = floor(uTime / period);
    float t = (uTime - n * period) / 0.9;              // lasts 0.9 s
    if (t > 1.0 || hash11(n * 3.7 + 1.0) > 0.45) return float3(0.0);
    float2 start = float2(hash11(n * 5.1) * uSize.x, (0.08 + 0.35 * hash11(n * 7.9)) * uHorizon);
    float ang = radians(200.0 + 50.0 * hash11(n * 2.3)) * (hash11(n * 1.1) > 0.5 ? 1.0 : -1.0);
    float2 dir = float2(cos(ang), abs(sin(ang)));
    float len = (60.0 + 80.0 * hash11(n * 4.4)) * uDp;
    float2 head = start + dir * len * t;
    float2 rel = fc - head;
    float along = dot(rel, -dir);
    float across = abs(dot(rel, float2(-dir.y, dir.x)));
    float trail = sat(1.0 - along / (len * 0.45)) * step(0.0, along);
    float s = exp(-across * across / (0.5 * uDp * uDp)) * trail * (1.0 - t) * smoothstep(0.0, 0.15, t);
    return float3(0.85, 0.92, 1.0) * s * 0.9;
}

// Moonlight scattered round the moon at night.
float3 moonHalo(float2 fc) {
    float d = length(fc - uMoon.xy) / uMoon.z;
    return float3(0.80, 0.85, 1.0) * exp(-max(d - 1.0, 0.0) * 0.9) * 0.07 * uNight * uMoon.w;
}

// The moon: a lit sphere (its phase follows the Sun), pale by day, with faint maria and earthshine.
float4 moon(float2 fc) {
    float r = uMoon.z;
    float2 d = (fc - uMoon.xy) / r;
    float dd = dot(d, d);
    if (dd > 1.0) return float4(0.0);
    float3 n = float3(d.x, d.y, sqrt(1.0 - dd));
    float lit = smoothstep(-0.06, 0.10, dot(n, uMoonLight));
    float maria = 0.80 + 0.20 * smoothstep(0.35, 0.65, fbm4(d * 2.2 + float2(4.0, 1.0), float4(1.0, 1.0, 0.7, 0.0)));
    float limb = 0.72 + 0.28 * n.z;
    float3 c = float3(0.98, 0.96, 0.90) * maria * limb * (lit + 0.05 * uNight);
    float edge = smoothstep(1.0, 1.0 - 2.0 / r, sqrt(dd));
    return float4(c, edge * uMoon.w);
}

// High cirrus: thin, wind-combed streaks at 9 km, lit long after the Sun has set below the land.
float4 cirrus(float3 v, float2 fc) {
    if (uWeather.y <= 0.001 || v.y < 0.01) return float4(0.0);
    float t = shellDistance(v.y, CIRRUS_H);
    float2 p = float2(v.x, v.z) * t;
    float2 q = float2(p.x * 0.75 + p.y * 0.66, -p.x * 0.66 + p.y * 0.75);
    q += float2(uWind * 1.6, 0.0);
    float warp = fbm4(q * 0.04 + uWeather.zw * 1.7, float4(1.0, 1.0, 0.0, 0.0));
    float fade = sat(1.0 - t / 260.0);
    float n = fbm4(float2(q.x * 0.010, q.y * 0.11 + warp * 1.6) + uWeather.wz, float4(1.0, 0.9, 0.35 * fade, 0.0));
    // Fine combing along the streaks.
    float fib = 0.75 + 0.25 * vnoise(float2(q.x * 0.004, q.y * 1.3 + warp * 6.0));
    float a = smoothstep(0.48, 0.80, n) * fib * uWeather.y * smoothstep(0.0, 0.10, v.y) * fade;
    float mu = dot(v, uSunDir);
    float3 c = uSunHigh * (0.55 + 5.0 * hg(mu, 0.55)) + uAmbTop * 1.2;
    return float4(c, a * 0.75);
}

// Distant cloud banks lying along the horizon: one sample of the cloud layer far away, combed flat by perspective;
// they catch the colours of sunrise and sunset first.
float4 banks(float3 v) {
    if (uWeather.x <= 0.001 || v.y > 0.14) return float4(0.0);
    float t = shellDistance(max(v.y, 0.002), 2.2);
    float2 p = float2(v.x, v.z) * t + float2(uWind, 0.0);
    float n = fbm4(p * float2(0.035, 0.11) + uWeather.zw, float4(1.0, 1.0, 0.8, 0.5));
    float a = smoothstep(0.62 - 0.25 * uWeather.x, 0.86 - 0.2 * uWeather.x, n) * smoothstep(18.0, 45.0, t) * (1.0 - smoothstep(0.05, 0.14, v.y));
    float mu = dot(v, uSunDir);
    float3 c = uSunCloud * (0.35 + 3.0 * hg(mu, 0.55)) + uAmbLow * 1.1;
    return float4(c, a * 0.85);
}

float4 render(float2 fc) {
    float alt = altAt(fc.y);
    float3 v = viewDir(fc);
    float3 sky = skyAt(fc.x, max(alt, 0.0));
    float3 col = sky;

    // Night (0.9.8): moonlight in the sky, the airglow low down on a dark night, the Milky Way where it really is, the
    // faint stars on the turning celestial sphere, the catalogue's bright stars, now and then a shooting star.
    float moonBright = uMoon.w * uMoonIllum * uNight;
    if (uNight > 0.0) {
        float dMoon = length(fc - uMoon.xy) / uSize.x;
        col += float3(0.020, 0.032, 0.060) * moonBright * (0.55 + 0.9 * exp(-dMoon * 2.2)) * smoothstep(-2.0, 25.0, alt + 20.0);
        col += float3(0.012, 0.030, 0.020) * exp(-pow((alt - 11.0) / 8.0, 2.0)) * uNight * (1.0 - moonBright);
        if (uMilky > 0.0) col += milkyWay(v, alt) * uMilky * (1.0 - 0.75 * moonBright);
        col += faintStars(v, alt, moonBright) * uNight;
        float4 bright = starAt(fc);
        col += bright.rgb * uNight * (1.0 - 0.35 * moonBright);
        col += meteor(fc) * smoothstep(0.7, 1.0, uNight) * (1.0 - moonBright);
    }

    // The moon, behind every cloud.
    if (uMoon.w > 0.0) {
        col += moonHalo(fc);
        float4 m = moon(fc);
        col = mix(col, max(col, m.rgb), m.a);
    }

    // High cirrus (paler behind the text written on the sky) and banks of cloud far along the horizon.
    float clear = smoothstep(uCloudTop - 12.0 * uDp, uCloudTop + 46.0 * uDp, fc.y);
    float4 ci = cirrus(v, fc);
    float ciA = ci.a * mix(0.35, 1.0, clear);
    if (ciA > 0.0) col = mix(col, tone(ci.rgb), ciA);
    float4 bk = banks(v);
    if (bk.a > 0.0) col = mix(col, mix(tone(bk.rgb), sky, 0.35), bk.a);

    // Text written on the sky stays readable (as the atmosphere table is): small text above gets 4.5:1, the large
    // countdown just above the text's bottom 3:1, and below it the limit lifts gradually. The Sun is not held to it.
    float textAbove = (uTextBottom - fc.y) / uDp;
    float capL = textAbove > 0.0 ? mix(0.30, 0.18, smoothstep(0.0, 50.0, textAbove)) : mix(0.30, 1.0, smoothstep(0.0, 45.0, -textAbove));
    if (capL < 1.0) {
        float3 lin = pow(sat3(col), float3(2.2));
        float l = luma(lin);
        if (l > capL) col = pow(lin * (capL / l), float3(1.0 / 2.2));
    }

    // The Sun's disc, which sinks behind the true horizon and goes behind the clouds.
    float2 sd = (fc - uSunPos) / uDp;
    float r = length(sd);
    float above = smoothstep(uHorizon + 0.5 * uDp, uHorizon - 0.5 * uDp, fc.y);
    float rd = 7.5;
    float disc = smoothstep(rd + 0.7, rd - 0.7, r) * above * (1.0 - 0.6 * ciA);
    if (disc > 0.0) {
        // The Sun adds light to the sky behind it: never darker than the sky, so it cannot turn black at the horizon.
        float limb = 1.0 - 0.45 * (1.0 - sqrt(sat(1.0 - (r / rd) * (r / rd))));
        float3 dc = tone(uSunDisc * limb) * disc;
        col = 1.0 - (1.0 - col) * (1.0 - dc);
    }

    // Glare round the Sun: a bright core and a wide soft bloom, in front of the clouds (the wide part kept gentle where
    // the text is).
    float sunVis = smoothstep(-5.0, 0.5, uSunEl);
    if (sunVis > 0.0) {
        float3 gc = tone(uSunGlow);
        float wide = 0.22 * exp(-r / 55.0) * mix(1.0, 0.4, smoothstep(-10.0, 30.0, textAbove));
        float g = (0.55 * exp(-max(r - rd, 0.0) / 9.0) + wide) * sunVis;
        col = 1.0 - (1.0 - col) * (1.0 - gc * g);
    }

    // A whisper of noise against banding in slow gradients.
    col += (hash12(fc + fract(uTime) * 61.0) - 0.5) / 255.0;
    return float4(sat3(col), 1.0);
}
