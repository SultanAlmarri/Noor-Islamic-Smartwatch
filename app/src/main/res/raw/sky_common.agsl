// Noor home sky, shared code (AGSL; also compiled as GLSL ES 3 by the design bench with a small prelude).
// Everything here is plain arithmetic: no preprocessor, no derivatives, constant loop bounds, explicit casts.
// Units: lengths in km for the world, pixels of the layer for the screen. The camera stands 0.25 km up and looks
// along +z (towards the Sun's side of the sky); x is to the right, y up.

const float PI = 3.14159265;
const float EARTH_R = 6360.0;
const float EYE_H = 0.25;
const float CLOUD_BASE = 1.2;
const float CLOUD_DEPTH = 1.8;
const float CIRRUS_H = 9.0;

float sat(float x) { return clamp(x, 0.0, 1.0); }
float3 sat3(float3 x) { return clamp(x, float3(0.0), float3(1.0)); }
float luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

// Hash without sine (Dave Hoskins): stable on every GPU, unlike fract(sin(x) * k).
float hash12(float2 p) {
    float3 p3 = fract(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

float2 hash22(float2 p) {
    float3 p3 = fract(float3(p.x, p.y, p.x) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, float3(p3.y, p3.z, p3.x) + 33.33);
    return fract((float2(p3.x, p3.x) + float2(p3.y, p3.z)) * float2(p3.z, p3.y));
}

// Value noise with a quintic fade, 0..1.
float vnoise(float2 p) {
    float2 i = floor(p);
    float2 f = p - i;
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash12(i);
    float b = hash12(i + float2(1.0, 0.0));
    float c = hash12(i + float2(0.0, 1.0));
    float d = hash12(i + float2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float vnoise1(float x) {
    float i = floor(x);
    float f = x - i;
    float u = f * f * (3.0 - 2.0 * f);
    return mix(hash11(i), hash11(i + 1.0), u);
}

const float2x2 ROT = float2x2(0.80, 0.60, -0.60, 0.80);

// Fractal sum of value noise; [octaves] is a weight per octave (1 = on), so fine octaves can fade with distance
// instead of shimmering. Output roughly 0..1.
float fbm4(float2 p, float4 w) {
    float s = 0.0;
    float a = 0.5;
    float n = 0.0;
    for (int i = 0; i < 4; i++) {
        float wi = i == 0 ? w.x : (i == 1 ? w.y : (i == 2 ? w.z : w.w));
        s += a * wi * vnoise(p);
        n += a * wi;
        p = ROT * p * 2.03 + float2(17.1, 9.2);
        a *= 0.5;
    }
    return s / max(n, 1e-4);
}

// The filmic curve used everywhere (ACES fit by K. Narkowicz), applied to luminance so that sunsets keep their hue,
// with a little per-channel roll-off so that the brightest light still turns towards white; then a gentle grade.
float aces(float x) { return sat((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }

float srgb1(float x) { return x <= 0.0031308 ? 12.92 * x : 1.055 * pow(x, 1.0 / 2.4) - 0.055; }

float3 tone(float3 c) {
    c = max(c, float3(0.0));
    float l = luma(c);
    float s = l > 1e-6 ? aces(l) / l : 0.0;
    float3 hp = min(c * s, float3(1.0));
    float3 pc = float3(aces(c.x), aces(c.y), aces(c.z));
    float3 o = hp * 0.7 + pc * 0.3;
    float y = luma(o);
    o = sat3(float3(y) + (o - float3(y)) * 1.25);
    return float3(srgb1(o.x), srgb1(o.y), srgb1(o.z));
}

// Distance along a ray from the eye, at [alt] (radians, > 0), to the sphere [h] km above the ground.
float shellDistance(float sinAlt, float h) {
    float r0 = EARTH_R + EYE_H;
    float r = EARTH_R + h;
    float b = r0 * sinAlt;
    return sqrt(max(b * b + r * r - r0 * r0, 0.0)) - b;
}

// Henyey–Greenstein phase function.
float hg(float mu, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * mu, 1e-4), 1.5));
}

// The day's cumulus field: thickness 0..1 at a point of the cloud layer (km). [cover] 0..1. [detail] fades the
// finest octaves with distance. [seed] moves the field from day to day; [wind] is the drift so far.
float cumulus(float2 p, float cover, float2 seed, float detail) {
    float2 q = p * 0.10 + seed;
    // Large cells decide where clouds are; billows of every size give them their tops.
    float base = fbm4(q, float4(1.0, 1.0, 0.8, 0.0));
    float billows = fbm4(q * 4.3 + float2(3.1, 7.7), float4(1.0, 1.0, detail, detail * 0.8));
    float c = base * 0.72 + billows * 0.28;
    float edge = 1.0 - cover;
    return sat((c - edge) / 0.30);
}

// Only the large cells: cheap, for shadows and early outs.
float cumulusCoarse(float2 p, float cover, float2 seed) {
    float2 q = p * 0.10 + seed;
    float base = fbm4(q, float4(1.0, 1.0, 0.0, 0.0));
    return sat((base * 0.72 + 0.14 - (1.0 - cover)) / 0.30);
}
