// Noor home sky: the land. Five layers of ridges (or dunes), far to near, each lit by the Sun of the moment from its
// side of the sky, shadowed by the passing cumulus, sinking into the haze with distance, with mist in the valleys at
// dawn; the nearest layer becomes the page itself. Full resolution (the skyline must be crisp); cached between frames.

uniform float2 uSize;      // px
uniform float uDp;         // px per dp
uniform float uHorizon;    // px
uniform float4 uBaseA;     // base line of layers 0..3, px
uniform float uBaseB;      // layer 4
uniform float4 uAmpA;      // height of layers 0..3, px
uniform float uAmpB;
uniform float4 uDistA;     // distance of layers 0..3, km
uniform float uDistB;
uniform float uRidgeN;     // samples across the width in the ridge table
uniform float uDunes;      // 1 in sand country
uniform float uFov;
uniform float2 uSunPos;    // px (same scale as this layer)
uniform float uSunEl;      // degrees, true
uniform float3 uSunGround; // sunlight on the ground (exposed, linear)
uniform float3 uAmbTop;
uniform float3 uAmbLow;
uniform float3 uPage;      // page colour, display
uniform float uMist;
uniform float uNight;
uniform float uTime;
uniform float4 uWeather;
uniform float uWind;
uniform float2 uLutSize;
uniform float uLutPow;
uniform float uSeed;       // the lie of the land

float pick4(float4 a, float b, int i) { return i == 0 ? a.x : (i == 1 ? a.y : (i == 2 ? a.z : (i == 3 ? a.w : b))); }

float ridgeAt(float x, int layer) {
    float u = sat(x / uSize.x) * (uRidgeN - 1.0) + 0.5;
    float4 t = ridgeTex(float2(u, layer < 3 ? 0.5 : 1.5));
    return layer == 0 ? t.r : (layer == 1 ? t.g : (layer == 2 ? t.b : (layer == 3 ? t.r : t.g)));
}

// Fine relief on the skyline the table is too coarse to hold: crags far away, scrub nearer, nothing on sand.
float edgeDetail(float x, int layer) {
    float xd = x / uDp + uSeed * 37.0;
    if (uDunes > 0.5) return 0.0;
    if (layer == 0) {
        float a = 1.0 - abs(vnoise1(xd * 0.22) * 2.0 - 1.0);
        float b = 1.0 - abs(vnoise1(xd * 0.55 + 7.0) * 2.0 - 1.0);
        return (a * a * 1.3 + b * b * 0.6) * uDp;
    }
    // Tree crowns and bushes along the crest: rounded bumps a few dp across.
    float s = vnoise1(xd * 0.33 + float(layer) * 13.0) * 0.7 + vnoise1(xd * 0.8 + float(layer) * 5.0) * 0.3;
    return s * s * (0.6 + 0.45 * float(layer)) * uDp;
}

float3 skyAt(float x, float altDeg) {
    float v = pow(sat(altDeg / 90.0), 1.0 / uLutPow);
    float2 p = float2(sat(x / uSize.x) * (uLutSize.x - 1.0) + 0.5, v * (uLutSize.y - 1.0) + 0.5);
    return lutAt(p).rgb;
}

// The colour of one layer at a point: lit surface in linear light, then haze over distance (display colours).
float3 shade(float2 fc, int layer, float topY, float slope) {
    float base = pick4(uBaseA, uBaseB, layer);
    float amp = max(pick4(uAmpA, uAmpB, layer), uDp);
    float dist = pick4(uDistA, uDistB, layer);
    float below = (fc.y - topY) / uDp;           // dp under the skyline
    float depth = sat(below / (amp / uDp * 0.9 + 14.0));
    float xd = fc.x / uDp;

    // The Sun's direction as seen from this point of the land.
    float az = (fc.x / uSize.x - 0.5) * uFov;
    float sunAz = (uSunPos.x / uSize.x - 0.5) * uFov;
    float e = radians(uSunEl);
    float da = sunAz - az;
    float3 L = float3(sin(da) * cos(e), sin(e), cos(da) * cos(e));

    // Surface: tilted by the slope of the skyline, turning towards the viewer further down the face.
    // (The slope matters near the crest; lower down the face turns towards the viewer whatever the skyline does.)
    float3 n = normalize(float3(slope * 1.4 * exp(-max(below, 0.0) / 9.0), 1.0, 0.0));
    float face = depth;
    float3 albedo;
    float bounce = 0.12;
    if (uDunes > 0.5) {
        // Sand: from each summit a sharp crest runs down across the dune to its lee side; on one side of it the
        // windward face, on the other the steeper slip face, so a low Sun lights one and leaves the other in shade.
        float hLee = ridgeAt(fc.x - 10.0 * uDp, layer);
        float wav = vnoise1(xd * 0.018 + float(layer) * 3.7 + uSeed) - 0.5;
        float crestDepth = (1.0 - hLee) * amp / uDp * 1.25 + wav * amp / uDp * 0.35 + 1.0;
        float side = smoothstep(crestDepth - 0.6, crestDepth + 0.6, below);
        float3 windward = normalize(float3(-0.50, 0.80, -0.30));
        float3 slip = normalize(float3(0.75, 0.40, -0.50));
        n = normalize(mix(n, mix(windward, slip, side), smoothstep(0.0, 2.5, below)));
        // Faint ripples on the windward faces of the nearest dunes.
        float rip = sin(xd * 0.9 + below * 1.6 + vnoise(float2(xd * 0.03, below * 0.06 + float(layer))) * 6.0);
        n = normalize(n + float3(0.0, rip * 0.035, rip * 0.035) * (1.0 - side) * sat(float(layer) - 2.0));
        float tint = vnoise(float2(xd * 0.012, below * 0.03 + float(layer) * 7.0));
        albedo = mix(float3(0.52, 0.32, 0.165), float3(0.62, 0.41, 0.23), tint);
        // Sand throws warm light into its own shadows.
        bounce = 0.30;
    } else {
        // Hills: bare rock and dry grass on the far range, scrub and woodland nearer; the relief catches the light
        // in patches.
        float fq = 0.05 + 0.035 * float(layer);
        float g = fbm4(float2(xd * fq, below * fq * 1.6) + float2(float(layer) * 7.3, uSeed), float4(1.0, 1.0, 0.7, 0.0));
        float relief = fbm4(float2(xd * fq * 1.4, below * fq * 1.4) + float2(uSeed * 3.0, float(layer) * 2.1), float4(1.0, 0.8, 0.6, 0.4));
        n = normalize(n + float3((relief - 0.5) * 1.6, 0.0, -1.4 * face + (relief - 0.5) * 0.6));
        float tf = 0.25 + 0.12 * float(layer);
        float trees = smoothstep(0.50, 0.80, vnoise(float2(xd * tf, below * tf * 1.3) + float2(float(layer) * 3.1, 0.0)));
        float3 rock = mix(float3(0.21, 0.20, 0.18), float3(0.30, 0.27, 0.22), g);
        float3 grass = mix(float3(0.14, 0.16, 0.07), float3(0.24, 0.23, 0.11), g);
        float3 wood = float3(0.055, 0.075, 0.035);
        albedo = layer == 0 ? mix(rock, grass, 0.25 + 0.3 * g) : mix(grass, wood, trees * (0.25 + 0.15 * float(layer)) + 0.15 * float(layer) / 4.0);
    }

    // Cloud shadows: from this point towards the Sun, is a cumulus in the way?
    float shadow = 1.0;
    if (uWeather.x > 0.001 && uSunEl > 1.5) {
        float2 g0 = float2(sin(az), cos(az)) * dist;
        float reach = (CLOUD_BASE + 0.4) / max(sin(e), 0.05);
        float2 c = g0 + float2(sin(sunAz), cos(sunAz)) * reach * cos(e) + float2(uWind, uWind * 0.35);
        float th = cumulusCoarse(c, uWeather.x, uWeather.zw);
        shadow = 1.0 - 0.72 * smoothstep(0.02, 0.35, th);
    }

    float diffuse = max(dot(n, L), 0.0);
    float3 sky = mix(uAmbLow, uAmbTop, n.y * 0.5 + 0.5);
    float3 lit = albedo * (uSunGround * (diffuse * 1.15 * shadow + bounce * sat(uSunEl / 20.0) * shadow) + sky * 0.95);
    // Rim of light along the crest when the Sun is low behind or beside it.
    float rimBand = exp(-max(below, 0.0) / (uDunes > 0.5 ? 1.6 : 1.0));
    float back = smoothstep(-1.0, 3.0, uSunEl) * (1.0 - smoothstep(8.0, 24.0, uSunEl));
    float rimNear = exp(-abs(fc.x - uSunPos.x) / (uSize.x * 0.22));
    lit += uSunGround * rimBand * back * rimNear * 1.6 * shadow;

    float3 c = tone(lit);
    // Haze: the far land takes the colour of the air at the horizon, blue light first.
    float3 air = skyAt(fc.x, 0.6 + 2.0 * (1.0 - depth));
    float3 k = float3(0.020, 0.026, 0.036) * (1.0 + 2.5 * uNight * 0.0);
    float3 tr = exp(-k * dist);
    c = mix(air, c, tr);
    // Mist in the valley at the foot of this layer.
    if (uMist > 0.001 && layer < 4) {
        float drift = vnoise(float2(xd * 0.010 + uTime * 0.004, float(layer) * 4.0)) * 0.7 + 0.3 * vnoise(float2(xd * 0.035 - uTime * 0.006, float(layer)));
        float m = smoothstep(base - amp * 0.55, base + 2.0 * uDp, fc.y) * uMist * (0.45 + 0.55 * drift) * (1.0 - 0.15 * float(layer));
        float3 mist = mix(air, float3(1.0), 0.18 * (1.0 - uNight));
        c = mix(c, mist, sat(m) * 0.85);
    }
    return c;
}

float4 render(float2 fc) {
    float4 acc = float4(0.0); // premultiplied, front to back
    float aa = 0.9;
    for (int i = 4; i >= 0; i--) {
        if (acc.a < 0.995) {
            float base = pick4(uBaseA, uBaseB, i);
            float amp = pick4(uAmpA, uAmpB, i);
            float h = ridgeAt(fc.x, i);
            float topY = base - amp * h - edgeDetail(fc.x, i);
            float cov = sat((fc.y - topY) / aa + 0.5);
            if (cov > 0.0) {
                // Slope over a few dp: the table holds 8-bit heights, too coarse to differentiate pixel by pixel.
                float hl = ridgeAt(fc.x - 4.0 * uDp, i);
                float hr = ridgeAt(fc.x + 4.0 * uDp, i);
                float slope = (hl - hr) * amp / (8.0 * uDp);
                float3 c = shade(fc, i, topY, slope);
                if (i == 4) {
                    // The nearest land is the page: it fades into the page colour, exactly so at the bottom edge.
                    // Mixed in linear light, so a dark dune meets a light page without a muddy grey band.
                    float t = smoothstep(topY + 4.0 * uDp, uSize.y - 2.0 * uDp, fc.y);
                    float3 cl = pow(sat3(c), float3(2.2));
                    float3 pl = pow(sat3(uPage), float3(2.2));
                    c = pow(mix(mix(cl, pl, 0.22), pl, t * t * (3.0 - 2.0 * t)), float3(1.0 / 2.2));
                }
                acc += float4(c, 1.0) * cov * (1.0 - acc.a);
            }
        }
    }
    acc.rgb += (hash12(fc) - 0.5) / 255.0 * acc.a;
    return acc;
}
