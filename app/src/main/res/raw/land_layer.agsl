// Noor home sky: the land. Five layers of ridges (or dunes), far to near, each lit by the Sun of the moment from its
// side of the sky, shadowed by the passing cumulus, sinking into the haze with distance, with mist in the valleys at
// dawn; the nearest layer becomes the page itself. Full resolution (the skyline must be crisp); cached between frames.

uniform float2 uSize;      // px
uniform float uDp;         // px per dp
uniform float uHorizon;    // px
uniform float4 uBaseA;     // base line of layers 0..3, px
uniform float uBaseB;      // layer 4
uniform float4 uAmpA;      // height of layers 0..3, px
uniform float uAmpB;
uniform float4 uDistA;     // distance of layers 0..3, km
uniform float uDistB;
uniform float uRidgeN;     // samples across the width in the ridge table
uniform float uDunes;      // 1 in sand country (0.19: unused, isDunes(); still set by the app and the bench)
uniform float uTerrain;    // 0 dunes, 1 hills, 2 mountains, 3 sea (0.9.8), 4 forest, 5 arctic, 6 canyon (0.19)
uniform float uAltTop;     // the sky's altitude at the top edge, degrees (for the sea's reflection)
uniform float uAltPow;
uniform float4 uMoonL;     // the moon: x, y (px), visibility, light (0 new … 1 full), for its path on the sea and moonlight
uniform float uFov;
uniform float2 uSunPos;    // px (same scale as this layer)
uniform float uSunEl;      // degrees, true
uniform float3 uSunGround; // sunlight on the ground (exposed, linear)
uniform float3 uAmbTop;
uniform float3 uAmbLow;
uniform float3 uPage;      // page colour, display
uniform float uMist;
uniform float uNight;
uniform float uTime;
uniform float4 uWeather;
uniform float uWind;
uniform float2 uLutSize;
uniform float uLutPow;
uniform float uSeed;       // the lie of the land
uniform float2 uSunrise;   // where the Sun rises and sets on the horizon (x, px; far off screen when it does not)
uniform float4 uWx;        // the weather of the moment (0.9.9): overcast, layer of cloud, rain here, -

float pick4(float4 a, float b, int i) { return i == 0 ? a.x : (i == 1 ? a.y : (i == 2 ? a.z : (i == 3 ? a.w : b))); }

// (0.19) The terrain, read only here: the app builds the land program with this line made a constant for the scenery
// shown (SkyShaders.landSource), so the compiler drops the other terrains' code and the GPU's driver prepares a
// program a fraction of the size. The bench and the compile test use the line as it is.
float terrainId() { return uTerrain; }
bool isDunes() { return terrainId() < 0.5; }
bool isSea() { return terrainId() > 2.5 && terrainId() < 3.5; }
bool isMountains() { return terrainId() > 1.5 && terrainId() < 2.5; }
bool isForest() { return terrainId() > 3.5 && terrainId() < 4.5; }
bool isArctic() { return terrainId() > 4.5 && terrainId() < 5.5; }
bool isCanyon() { return terrainId() > 5.5; }
bool isHills() { return terrainId() > 0.5 && terrainId() < 1.5; }
// The forest's lake, the arctic fjord (0.19) and the green hills' reservoir (0.21): still water in the middle distance, layer 2.
bool isLake(int layer) { return layer == 2 && (isForest() || isArctic() || isHills()); }

float ridgeAt(float x, int layer) {
    float u = sat(x / uSize.x) * (uRidgeN - 1.0) + 0.5;
    float4 t = ridgeTex(float2(u, layer < 3 ? 0.5 : 1.5));
    return layer == 0 ? t.r : (layer == 1 ? t.g : (layer == 2 ? t.b : (layer == 3 ? t.r : t.g)));
}

// The height of [layer] at [x], 0..1 of its height. (0.19.1: the land no longer opens onto the true horizon where the
// Sun rises and sets: the Sun's path is drawn in front of the land, and every skyline is natural. uSunrise is unused.)
float landHeight(float x, int layer, float base, float amp) { return ridgeAt(x, layer); }

// One spire of the treeline at cell [c] (see [conifers]); dp.
float spire(float c, float xc, float sp, float tall, float g, int layer) {
    if (g <= 0.0) return 0.0;   // no tree where the ground has not risen (also keeps the function out of line: below)
    float hh = hash11(c * 1.37 + float(layer) * 7.0);
    float cx = c + 0.5 + (hash11(c * 2.71 + 5.0) - 0.5) * 0.7;
    // A tree stands only where the ground has risen far enough for it (its own threshold, so they thin out).
    float th = tall * (0.5 + 0.5 * hh) * smoothstep(hh * 0.6, hh * 0.6 + 0.25, g);
    float t = 1.0 - abs(xc - cx) * sp / max(th * 0.2, 0.5);
    // Tiers of branches: the flank steps in a little every couple of dp.
    float y = th * sat(t);
    return y - min(fract(y / 2.4 + hh * 3.0) * 1.1, y) * sat(th / 8.0);
}

// The treeline (0.19): the pointed tops of conifers along the crest, narrow spires with tiers of branches, larger and
// further apart on the nearer layers, standing where the ground rises (none where it falls to the water). dp.
// (Android's shader compiler copies a function called once, with its only return at the end, into its caller; copied
// into edgeDetail's `if (...) return conifers(...)`, it lost this function's first local ("'_6_s' / '_6_sp' :
// undeclared identifier" in the GLSL it generated) and the medium graphics drew no land at all, while the WebGL bench
// and Robolectric's compiler were fine. A function that can return early is never copied: hence the first lines here
// and in spire, which change no result.)
float conifers(float x, int layer) {
    if (layer < 1) return 0.0;  // (edgeDetail asks for layers 1 to 4 only)
    float sp = layer == 1 ? 2.3 : (layer == 3 ? 5.0 : 8.5);         // spacing
    float tall = layer == 1 ? 5.5 : (layer == 3 ? 30.0 : 34.0);     // the tallest
    float g = layer == 1 ? 1.0 : (layer == 4 ? smoothstep(0.45, 0.75, ridgeAt(x, layer)) : smoothstep(0.16, 0.5, ridgeAt(x, layer)));
    float xc = x / uDp / sp + uSeed * 3.1 + float(layer) * 17.0;
    float ci = floor(xc);
    float best = max(max(spire(ci - 1.0, xc, sp, tall, g, layer), spire(ci, xc, sp, tall, g, layer)), spire(ci + 1.0, xc, sp, tall, g, layer));
    // Lower crowns fill in between the spires.
    return max(best, tall * 0.18 * g * (0.6 + 0.4 * vnoise1(xc * 2.3))) * uDp;
}

// (0.21) Round crowns of broadleaf trees along a crest, standing in groves (the oaks of the green hills, the
// cottonwoods on the red rock's floor): one dome per cell, dp. (An early return: see conifers.)
float crowns(float x, int layer) {
    if (layer < 1) return 0.0;
    float sz = layer == 1 ? 2.6 : (layer == 2 ? 7.5 : (layer == 3 ? 8.0 : 6.0));
    float xc = x / uDp / sz + uSeed * 1.3 + float(layer) * 7.0;
    float ci = floor(xc);
    float h = hash11(ci * 1.71 + float(layer));
    float h2 = hash11(ci * 3.13 + 7.0);
    float grove = smoothstep(0.40, 0.66, vnoise1(xc * 0.13 + float(layer) * 3.0));
    // (A crown wider than its cell and off its middle, so neighbours overlap into one canopy, uneven in height.)
    float d = (xc - ci - 0.3 - 0.4 * h2) / (0.55 + 0.35 * h);
    float dome = sqrt(max(1.0 - d * d, 0.0)) * (0.5 + 0.5 * h);
    float canopy = 0.35 + 0.25 * vnoise1(xc * 0.7);
    return max(dome, canopy * grove) * sz * 0.8 * grove;
}

// Fine relief on the skyline the table is too coarse to hold: crags far away, trees, nothing on sand.
float edgeDetail(float x, int layer) {
    float xd = x / uDp + uSeed * 37.0;
    if (isDunes() || isLake(layer)) return 0.0;
    // (0.21: where a near shore lies under the water nothing stands on it: no strip of land along the waterline.)
    if (layer == 3 && !isSea() && ridgeAt(x, 3) < 0.10) return 0.0;
    if (isSea() && layer <= 2) return ridgeAt(x, layer) > 0.02 ? (vnoise1(xd * 0.4) * 0.8) * uDp : 0.0;
    if (isSea()) return 0.0;                     // sand: smooth
    if (isForest() && layer > 0) return conifers(x, layer);
    if ((isHills() && layer != 2) || (isCanyon() && layer == 2)) return crowns(x, layer) * uDp;
    // Red rock: crisp, smooth edges. Snow: soft drifts.
    if (isCanyon()) return layer >= 3 ? 0.0 : 0.12 * vnoise1(xd * 0.9) * uDp;
    if (isArctic() && layer >= 3) return vnoise1(xd * 0.2 + float(layer) * 13.0) * 0.8 * uDp;
    bool high = isMountains() || isArctic();
    if (layer == 0 || (high && layer == 1)) {
        float a = 1.0 - abs(vnoise1(xd * 0.22) * 2.0 - 1.0);
        float b = 1.0 - abs(vnoise1(xd * 0.55 + 7.0) * 2.0 - 1.0);
        float k = high ? 2.0 : 1.0;
        return (a * a * 1.3 + b * b * 0.6) * uDp * k;
    }
    // Bushes along the crest: rounded bumps a few dp across.
    float s = vnoise1(xd * 0.33 + float(layer) * 13.0) * 0.7 + vnoise1(xd * 0.8 + float(layer) * 5.0) * 0.3;
    return s * s * (0.6 + 0.45 * float(layer)) * uDp;
}

// (0.21) The broad slope of a layer's crest over a window that widens down its face (px of height per px across): each
// face of a hill, a mountain or a butte is lit as one surface, turned to the Sun or away, the seam between two faces
// running down from each summit and softening as it goes, as the dunes' faces are. (An early return: see conifers.)
float faceSlope(float x, int layer, float below, float amp) {
    if (amp <= 0.0) return 0.0;
    float d = clamp((isCanyon() ? 14.0 : 5.0) + 0.7 * max(below, 0.0), 5.0, 48.0) * uDp;
    return (ridgeAt(x - d, layer) - ridgeAt(x + d, layer)) * amp / (2.0 * d);
}

// The top of [layer] at [x], px: its ridge, then the fine relief of its skyline.
float topOf(float x, int layer) {
    float base = pick4(uBaseA, uBaseB, layer);
    float amp = pick4(uAmpA, uAmpB, layer);
    return base - amp * landHeight(x, layer, base, amp) - edgeDetail(x, layer);
}

// Two octaves of value noise: soft patches (cheaper than fbm4 where the fine octaves are not wanted).
float fbm2(float2 p) { return vnoise(p) * 0.667 + vnoise(ROT * p * 2.03 + float2(17.1, 9.2)) * 0.333; }

// A thin silver edge along the crests nearest the moon.
float rimBandMoon(float below) { return exp(-max(below, 0.0) / 1.2); }

float3 skyAt(float x, float altDeg) {
    float v = pow(sat(altDeg / 90.0), 1.0 / uLutPow);
    float2 p = float2(sat(x / uSize.x) * (uLutSize.x - 1.0) + 0.5, v * (uLutSize.y - 1.0) + 0.5);
    return lutAt(p).rgb;
}

// The far shore's skyline as still water shows it (0.19): the ridge, and the treeline as a ragged band (the ripples
// blur the single trees away; cheaper than the trees themselves).
float mirroredTop(float x, int l) {
    float base = pick4(uBaseA, uBaseB, l);
    float amp = pick4(uAmpA, uAmpB, l);
    float trees = isForest() && l == 1 ? (2.0 + 2.5 * vnoise1(x / uDp * 0.45 + uSeed)) * uDp : 0.0;
    return base - amp * landHeight(x, l, base, amp) - trees;
}

// The far shore as still water shows it (0.19): its own colours, simply lit, hazed by its distance. [y] is the point
// reflected; [l] its layer (0 or 1).
float3 farShore(float x, float y, int l) {
    float base = pick4(uBaseA, uBaseB, l);
    float rel = sat((base - y) / max(pick4(uAmpA, uAmpB, l), uDp));
    float3 snow = float3(0.80, 0.83, 0.88);
    float rock = vnoise(float2(x / uDp * 0.07, rel * 7.0 + float(l) * 3.0));
    // (0.19.1: the fjord's mountains as streaks of snow and rock running down, as their faces are.)
    float hx = ridgeAt(x, l);
    float cliff = smoothstep(0.50, 0.62, rel / max(hx, 0.08) + (rock - 0.5) * 0.55 + 0.25 * hx - 0.1);
    float3 alb = isForest()
        ? (l == 1 ? float3(0.032, 0.055, 0.04) : mix(mix(float3(0.05, 0.075, 0.06), float3(0.17, 0.16, 0.155), smoothstep(0.22, 0.4, rel)), snow, smoothstep(0.38, 0.5, rel + rock * 0.15)))
        : (isHills() ? mix(float3(0.12, 0.17, 0.065), float3(0.26, 0.28, 0.11), rock)
        : (isCanyon() ? (l == 1 ? float3(0.50, 0.19, 0.08) : float3(0.55, 0.30, 0.18)) : mix(snow, float3(0.05, 0.05, 0.055), cliff * 0.45)));
    float3 lit = alb * (uSunGround * 0.75 * sat(uSunEl / 12.0 + 0.2) + mix(uAmbLow, uAmbTop, 0.6) * 1.4);
    float3 tr = exp(-float3(0.020, 0.026, 0.036) * pick4(uDistA, uDistB, l));
    return mix(skyAt(x, 0.6 + 2.0 * rel), tone(lit), tr);
}

// The sea (0.9.8): a calm sea mirrors the sky, more so towards the horizon where the light grazes it; small waves,
// finer and closer together with distance, tilt the reflection; the Sun (and the moon at night) lays a glittering path
// across the water towards the viewer; a line of foam where the water meets the shore.
// (0.19) [calm] 1: the still water of a lake or a fjord, which mirrors its far shore too; no swell, no surf.
float3 water(float2 fc, float shoreTop, float calm) {
    float dy = max(fc.y - uHorizon, 0.4 * uDp);
    float dyDp = dy / uDp;
    float z = 60.0 / (dyDp + 1.5);                       // how far away this part of the sea is (arbitrary units)
    float2 wp = float2(fc.x / uDp * 0.045 * z / 6.0, z * 1.6) + float2(uTime * 0.02, uTime * 0.05);
    float w1 = vnoise(wp * float2(1.0, 0.35));
    float w2 = vnoise(wp * float2(2.3, 0.8) + float2(3.1, 7.7));
    float slope = ((w1 - 0.5) * 0.7 + (w2 - 0.5) * 0.4) * (1.0 - 0.75 * calm);   // tilt of the little waves
    // The angle below the horizon, then the sky at the same angle above it, shifted by the waves.
    float dep = uAltTop * pow(sat(dy / uHorizon), uAltPow);
    float altR = max(dep * (1.0 + slope * 0.9) + slope * 1.5, 0.0);
    float3 refl = skyAt(fc.x + slope * 6.0 * uDp, altR);
    if (calm > 0.5) {
        // The far shore upside down: the point as far above the water's edge as this one is below it.
        float my = 2.0 * pick4(uBaseA, uBaseB, 2) - fc.y + slope * 4.0 * uDp;
        float mx = fc.x + slope * 5.0 * uDp;
        float in1 = sat((my - mirroredTop(mx, 1)) / uDp + 0.5);
        float in0 = sat((my - mirroredTop(mx, 0)) / uDp + 0.5);
        refl = mix(refl, mix(farShore(mx, my, 0), farShore(mx, my, 1), in1), max(in0, in1) * 0.96);
    }
    refl = mix(refl, float3(luma(refl)) * 0.85, sat(uWx.x * 0.9 + uWx.z * 0.4));
    float cosv = sin(radians(max(dep, 0.3)));
    float fres = 0.02 + 0.98 * pow(1.0 - cosv, 5.0);
    float3 deep = tone(uAmbTop * 0.10 + uSunGround * 0.012) * float3(0.55, 0.85, 0.95);
    // (0.19) The fjord is deep and dark: it mirrors less than the shallow, sunlit sea.
    float3 c = mix(deep * (isArctic() ? 0.5 : 1.0), refl, sat(0.25 + 0.75 * fres) * (isArctic() ? 0.72 : 1.0));
    // Long swells and wind ripples, drawn out sideways by perspective, darker in the troughs.
    float swell = vnoise(float2(fc.x / uDp * 0.010 * z / 6.0, z * 3.2 + uTime * 0.04));
    float ripple = vnoise(float2(fc.x / uDp * 0.05 * z / 6.0, z * 9.0 - uTime * 0.07));
    c *= mix(0.86 + 0.16 * swell + 0.10 * ripple, 0.95 + 0.08 * ripple, calm);
    // The Sun's path: bright flecks where a wave faces it, in a band that widens towards the shore.
    float sunUp = smoothstep(-1.0, 1.5, uSunEl) * (1.0 - 0.6 * smoothstep(20.0, 60.0, uSunEl)) * (1.0 - 0.95 * uWx.x)
        * (1.0 - calm * smoothstep(3.0, 14.0, uSunEl) * 0.85);
    if (sunUp > 0.0) {
        float width = (6.0 + dyDp * 0.7) * uDp * (1.0 + 0.05 * max(uSunEl, 0.0));
        float lane = exp(-pow((fc.x - uSunPos.x) / width, 2.0));
        float flecks = pow(sat(w1 * 0.55 + w2 * 0.55 + ripple * 0.3 - 0.25), 5.0) * 7.0;
        // Sparkles on a softer sheen (0.9.9: the sheen alone was a flat white blot).
        c += tone(uSunGround * 1.6 + uSunGround * 2.0 * (1.0 - smoothstep(2.0, 12.0, uSunEl))) * lane * (flecks * 1.2 + 0.14) * sunUp;
    }
    // The moon's path at night.
    float moonUp = uMoonL.z * uNight;
    if (moonUp > 0.0) {
        float width = (4.0 + dyDp * 0.45) * uDp;
        float lane = exp(-pow((fc.x - uMoonL.x) / width, 2.0));
        float glint = pow(sat(w1 * 0.6 + w2 * 0.6 - 0.2), 6.0) * 4.0 + 0.15;
        c += float3(0.62, 0.68, 0.80) * lane * glint * moonUp * (0.25 + 0.75 * uMoonL.w) * 0.55;
    }
    // Foam where the sea meets the shore.
    float foam = exp(-max(shoreTop - fc.y, 0.0) / (1.2 * uDp)) * step(fc.y, shoreTop + uDp) * (0.55 + 0.45 * vnoise(float2(fc.x / uDp * 0.15, uTime * 0.3)));
    c = mix(c, tone(uSunGround * 0.9 + uAmbTop * 1.4) + float3(0.04), foam * 0.6 * (1.0 - calm));
    return c;
}

// The colour of one layer at a point: lit surface in linear light, then haze over distance (display colours).
float3 shade(float2 fc, int layer, float topY, float slope) {
    float base = pick4(uBaseA, uBaseB, layer);
    float amp = max(pick4(uAmpA, uAmpB, layer), uDp);
    float dist = pick4(uDistA, uDistB, layer);
    float below = (fc.y - topY) / uDp;           // dp under the skyline
    float depth = sat(below / (amp / uDp * 0.9 + 14.0));
    // How high up the layer this point is (0 at its foot, 1 at its highest): on jagged ranges the light, the haze and
    // the snowline follow altitude, not the distance below the crest straight above (which made vertical bands).
    float rel = sat((base - fc.y) / amp);
    bool range = ((isMountains() || isArctic()) && layer <= 1) || (isForest() && layer == 0);
    // (0.19.1: on every farthest layer too: by the distance below the crest straight above, each notch let a
    // vertical streak of light down the whole face.)
    if (range || layer == 0) depth = mix(depth, 1.0 - rel, 0.85);
    float xd = fc.x / uDp;

    // The Sun's direction as seen from this point of the land.
    float az = (fc.x / uSize.x - 0.5) * uFov;
    float sunAz = (uSunPos.x / uSize.x - 0.5) * uFov;
    float e = radians(uSunEl);
    float da = sunAz - az;
    float3 L = float3(sin(da) * cos(e), sin(e), cos(da) * cos(e));

    // Surface: tilted by the slope of the skyline, turning towards the viewer further down the face.
    // (The slope matters near the crest; lower down the face turns towards the viewer whatever the skyline does.)
    float3 n = normalize(float3(slope * 1.4 * exp(-max(below, 0.0) / 9.0), 1.0, 0.0));
    float face = depth;
    float3 albedo;
    float bounce = 0.12;
    // (0.21) How much of the skylight a steep face takes from the whole dome rather than the horizon's band: a steep
    // snowfield or wall at dusk is lit by the blue sky above, not only by the orange band at the horizon.
    float skyUp = 0.0;
    // Open water; a headland's foot meets the sea at the horizon (0.9.9: its land ran on below the horizon down to
    // the next layer, ending in a straight vertical edge where the headland's tip met the water).
    float rx = ridgeAt(fc.x, layer);
    bool lake = isLake(layer);
    // (0.19.1) The fjord's rocks stand in its water, and the lake runs in between the forest's wooded knolls, as in
    // the real sky's sceneries: under their waterline, water.
    // (0.21: the green hills' near shore stands in its reservoir, and the red rock's pool lies in its near bank.)
    bool rocksInWater = (isArctic() || isForest() || isHills() || isCanyon()) && layer == 3;
    bool wet = rocksInWater && rel < (isArctic() ? 0.03 : 0.12) + 0.03 * vnoise1(xd * 0.3);
    if (lake || wet || (isSea() && layer <= 2 && (rx < 0.02 || fc.y > uHorizon + 2.0 * uDp * sat(rx * 4.0)))) {
        int sl = rocksInWater ? 4 : 3;
        float sb = pick4(uBaseA, uBaseB, sl); float sa = pick4(uAmpA, uAmpB, sl);
        float3 cw = water(fc, sb - sa * landHeight(fc.x, sl, sb, sa), (lake || wet) ? 1.0 : 0.0);
        float3 airW = skyAt(fc.x, 0.6);
        float distW = min(dist, 60.0 / (max(fc.y - uHorizon, 0.0) / uDp + 2.0));
        return mix(airW, cw, exp(-0.02 * distW));
    }
    if (isDunes() || (isSea() && layer >= 3)) {
        // Sand: from each summit a sharp crest runs down across the dune to its lee side; on one side of it the
        // windward face, on the other the steeper slip face, so a low Sun lights one and leaves the other in shade.
        float hLee = ridgeAt(fc.x - 10.0 * uDp, layer);
        float wav = vnoise1(xd * 0.018 + float(layer) * 3.7 + uSeed) - 0.5;
        float crestDepth = (1.0 - hLee) * amp / uDp * 1.25 + wav * amp / uDp * 0.35 + 1.0;
        float side = smoothstep(crestDepth - 0.6, crestDepth + 0.6, below);
        float3 windward = normalize(float3(-0.50, 0.80, -0.30));
        float3 slip = normalize(float3(0.75, 0.40, -0.50));
        n = normalize(mix(n, mix(windward, slip, side), smoothstep(0.0, 2.5, below)));
        // Ripples on the windward faces of the nearer dunes (0.19.1: as the real sky's sand shows them, finer with
        // distance, crossing the slope).
        float rip = sin(xd * (0.55 + 0.25 * float(layer)) + below * 2.2 + vnoise(float2(xd * 0.03, below * 0.06 + float(layer))) * 6.0);
        n = normalize(n + float3(rip * 0.05, rip * 0.06, rip * 0.05) * (1.0 - side) * sat(float(layer) - 1.5));
        float tint = vnoise(float2(xd * 0.012, below * 0.03 + float(layer) * 7.0));
        albedo = mix(float3(0.52, 0.32, 0.165), float3(0.62, 0.41, 0.23), tint);
        // Sand throws warm light into its own shadows (0.19.1: less, so a low Sun leaves the slip faces in shade).
        bounce = 0.16;
        if (isSea()) {
            // By the sea (0.9.9): a plain beach, pale dry sand rising gently to low dunes behind it, darker wet sand
            // along the water's edge, the faintest ripples; no streaks.
            n = normalize(float3(slope * 0.6 * exp(-max(below, 0.0) / 6.0), 1.0, -0.25));
            float sb = pick4(uBaseA, uBaseB, 3); float sa = pick4(uAmpA, uAmpB, 3);
            float shore = sb - sa * landHeight(fc.x, 3, sb, sa);
            float wet = layer == 3 ? 1.0 - smoothstep(0.0, 5.0 * uDp, fc.y - shore) : 0.0;
            float soft = vnoise(float2(xd * 0.02, below * 0.05 + float(layer) * 9.0));
            albedo = mix(float3(0.50, 0.44, 0.34), float3(0.58, 0.51, 0.40), soft);
            albedo = mix(albedo, float3(0.30, 0.27, 0.22), wet * 0.7);
            bounce = 0.22;
        }
    } else {
        // (0.21) Painted, as the dunes are: every face of a hill, a mountain or a butte lit as one smooth surface by
        // the light of the moment ([faceSlope]), turned towards the viewer further down; colour in broad soft fields;
        // fine texture only where it helps, near. (0.19's land was blotches, gullies, strata and crowns in grids.)
        float hb = faceSlope(fc.x, layer, below, amp);
        float hold = exp(-max(below, 0.0) / (amp / uDp * 0.9 + 12.0));
        float side = clamp(hb * 1.5 * (0.35 + 0.65 * hold) + slope * 0.8 * exp(-max(below, 0.0) / 8.0), -2.2, 2.2);
        float broad = vnoise(float2(xd * 0.010, below * 0.016) + float2(float(layer) * 5.3, uSeed));
        float hx = ridgeAt(fc.x, layer);
        float topRel = rel / max(hx, 0.08);
        bool peak = ((isArctic() || isMountains()) && layer <= 1) || (isForest() && layer == 0);
        if (peak) {
            // Mountains: soft ribs and couloirs down the fall line, leaning with the face; dark rock where the face is
            // steep and on the ribs near the summits, snow where it can lie (the arctic's nearly to the water, the
            // volcano's from its shoulders up, over dark forest and grey rock).
            float2 fp = float2(xd * 0.045 + below * 0.022 * clamp(side, -1.0, 1.0), below * 0.010 + float(layer) * 5.0 + uSeed);
            float ribs = (1.0 - abs(vnoise(fp) * 2.0 - 1.0)) * 0.65 + (1.0 - abs(vnoise(fp * float2(2.3, 1.6) + 3.0) * 2.0 - 1.0)) * 0.35;
            n = normalize(float3(side * 1.6 + (ribs - 0.5) * 0.9 * sat(topRel + 0.2), 0.34, -0.72));
            // (Dark rock on the steep upper faces, snow lying in the couloirs between its ribs; snow on the gentle aprons.)
            float rockA = smoothstep(0.8, 1.5, abs(side) + (ribs - 0.5) * 0.6) * smoothstep(0.25, 0.6, topRel) * (1.0 - smoothstep(0.62, 0.82, ribs));
            float line = isArctic() ? -1.0 : (isForest() ? 0.44 : 0.55);
            float snow = smoothstep(line - 0.07, line + 0.07, rel + (ribs - 0.5) * 0.14) * (1.0 - rockA * (isArctic() ? 0.8 : 0.55));
            float3 rock = isArctic() ? float3(0.075, 0.075, 0.085) : float3(0.17, 0.16, 0.155);
            float3 low = isForest() ? float3(0.05, 0.075, 0.06) : float3(0.15, 0.16, 0.11);
            albedo = mix(mix(low, rock, smoothstep(0.22, 0.40, rel)), float3(0.62, 0.65, 0.70), snow) * (0.93 + 0.14 * broad);
            bounce = mix(0.08, 0.28, snow);
            skyUp = 0.8;
        } else if (isForest()) {
            // Firs: a stand of them is dark; each tree's column a little lighter or darker, its side towards the Sun
            // catching the light; moss and stone on the bank where no tree stands.
            float sp = layer == 1 ? 2.3 : (layer == 3 ? 5.0 : 8.5);
            float trees = layer == 1 ? 1.0 : smoothstep(0.16, 0.5, hx);
            float colm = vnoise(float2(xd / sp + uSeed * 3.1 + float(layer) * 17.0, below / (sp * 3.0)));
            n = normalize(float3(side * 0.8 + (colm - 0.5) * 0.5, 0.8, -0.6));
            float3 needles = mix(float3(0.024, 0.044, 0.034), float3(0.052, 0.078, 0.046), colm * 0.6 + broad * 0.4);
            float3 ground = mix(float3(0.10, 0.10, 0.07), float3(0.17, 0.17, 0.12), broad);
            albedo = mix(ground, needles, trees);
            bounce = 0.06;
        } else if (isCanyon() && layer <= 1) {
            // Red rock: buttes and spires on skirts of talus; their walls smooth faces of soft, faint strata, fluted a
            // little by the rain, a paler cap, lit as one face or another.
            float talus = 1.0 - smoothstep(0.16, 0.30, rel + (broad - 0.5) * 0.12);
            float flute = (vnoise(float2(xd * 0.22, rel * 0.9 + float(layer) * 4.0)) - 0.5) * 0.4 * (1.0 - talus);
            n = normalize(float3(side * 1.3 + flute, mix(0.20, 0.95, talus), -1.0));
            float strata = vnoise1(rel * 8.0 + broad * 1.6 + float(layer) * 3.0);
            float3 rock = mix(float3(0.44, 0.13, 0.055), float3(0.58, 0.24, 0.10), 0.5 + (strata - 0.5) * 0.5);
            rock = mix(rock, float3(0.62, 0.44, 0.30), smoothstep(0.86, 0.98, topRel) * 0.6);
            albedo = mix(rock, mix(float3(0.42, 0.17, 0.08), float3(0.55, 0.28, 0.14), broad), talus);
            bounce = 0.28;
            skyUp = 0.6;
        } else if (isCanyon() || (isSea() && layer >= 3) || (isArctic() && layer >= 3)) {
            // Banks: the red rock's sand floor and the pool's banks, the beach, the fjord's snow and its rocks; smooth
            // drifts lit as the dunes are, the faintest ripples near.
            n = normalize(float3(side * 0.75, 1.0, -0.30 - 0.5 * depth));
            float rip = sin(xd * (0.5 + 0.2 * float(layer)) + below * 2.0 + broad * 6.0) * sat(float(layer) - 2.5);
            n = normalize(n + float3(rip * 0.04, rip * 0.05, 0.0));
            if (isArctic()) {
                // Rocks in the water (layer 3) under caps of snow; snow on the bank in front.
                float cap = layer == 3 ? (1.0 - smoothstep(0.8, 2.6, below)) * smoothstep(0.55, 0.8, topRel) : 1.0;
                float rockA = layer == 3 ? 1.0 - cap : 0.0;
                n = normalize(float3(side * (1.0 + 1.2 * rockA), 1.0 - 0.5 * rockA, -0.5 - 0.4 * rockA));
                albedo = mix(float3(0.80, 0.83, 0.88) * (0.95 + 0.05 * broad), mix(float3(0.06, 0.06, 0.065), float3(0.13, 0.125, 0.12), broad), rockA);
                bounce = 0.3;
            } else if (isSea()) {
                // The beach: pale dry sand, darker wet sand along the water's edge.
                float sb = pick4(uBaseA, uBaseB, 3); float sa = pick4(uAmpA, uAmpB, 3);
                float shore = sb - sa * landHeight(fc.x, 3, sb, sa);
                float wetS = layer == 3 ? 1.0 - smoothstep(0.0, 5.0 * uDp, fc.y - shore) : 0.0;
                albedo = mix(mix(float3(0.50, 0.44, 0.34), float3(0.58, 0.51, 0.40), broad), float3(0.30, 0.27, 0.22), wetS * 0.7);
                bounce = 0.22;
            } else if (layer == 2) {
                // The red rock's floor under the buttes: a band of green trees (their crowns stand on the skyline),
                // red sand between.
                float tree = max(smoothstep(0.30, 0.60, broad + 0.35 - below / (amp / uDp + 8.0) * 0.8), 1.0 - smoothstep(-1.0, 1.5, below - crowns(fc.x, 2) * 1.1));
                float drift = vnoise(float2(xd * 0.03, below * 0.09 + 4.0));
                n = normalize(float3(side * 0.8 + (drift - 0.5) * 0.4 * (1.0 - tree), 1.0, -0.5 - 0.4 * tree));
                albedo = mix(mix(float3(0.52, 0.23, 0.10), float3(0.64, 0.36, 0.19), drift), mix(float3(0.06, 0.09, 0.04), float3(0.12, 0.15, 0.06), broad), tree);
                bounce = 0.2;
            } else {
                float drift = vnoise(float2(xd * 0.03, below * 0.07 + float(layer) * 4.0));
                n = normalize(n + float3((drift - 0.5) * 0.4, 0.0, 0.0));
                albedo = mix(float3(0.56, 0.25, 0.11), float3(0.70, 0.40, 0.21), broad * 0.6 + drift * 0.4);
                bounce = 0.26;
            }
        } else {
            // Green hills (and the 0.9 mountains' foothills, the far headland): grass in broad soft fields, lit
            // as smooth rounded forms; oaks in groves on their slopes, round crowns on their crests; blades of grass
            // near.
            n = normalize(float3(side * 0.9, 1.0, -0.30 - 1.0 * depth));
            albedo = mix(float3(0.12, 0.17, 0.065), float3(0.29, 0.30, 0.11), broad * 0.85 + 0.1 * sat(1.0 - depth));
            if (layer >= 3) albedo *= 0.95 + 0.10 * vnoise(float2(xd * 0.6, below * 0.35));
            // Woods lie in soft dark fields along the folds of the hills; oaks dotted on the nearer slopes, in groves.
            float wood = smoothstep(0.55, 0.8, vnoise(float2(xd * 0.022, below * 0.05) + float2(uSeed * 2.0, float(layer) * 3.0)) + side * 0.15);
            albedo = mix(albedo, float3(0.06, 0.09, 0.04), wood * 0.7);
            // The crowns standing on the crest (edgeDetail): rounded, lit on their top and the Sun's side.
            float ch = crowns(fc.x, layer);
            float oak = 1.0 - smoothstep(-1.0, 1.5, below - ch * 1.1);
            float into = sat(below / max(ch, 1.0));
            n = normalize(mix(n, float3(side * 0.6, 1.0 - into, -0.4 - into), oak * 0.8));
            albedo = mix(albedo, float3(0.045, 0.075, 0.03), oak);
            if (isSea()) albedo = mix(float3(0.24, 0.22, 0.16), float3(0.20, 0.26, 0.12), broad);
            bounce = 0.12;
        }
    }

    // (0.19.1: no cloud shadows of the shader's own: the clouds are the real sky's sets, drawn over the sky.)
    float shadow = 1.0;

    // Under an overcast the land is lit by the grey sky alone, softly, without shadows; rain dims it further.
    float direct = (1.0 - 0.85 * uWx.x) * (1.0 - 0.4 * uWx.z);
    shadow *= direct;
    float diffuse = max(dot(n, L), 0.0);
    float3 sky = mix(uAmbLow, uAmbTop, max(n.y * 0.5 + 0.5, skyUp));
    sky = mix(sky, float3(luma(sky)), 0.8 * uWx.x);
    float3 lit = albedo * (uSunGround * (diffuse * 1.15 * shadow + bounce * sat(uSunEl / 20.0) * shadow) + sky * (0.95 + 0.5 * uWx.x));
    // Rim of light along the crest when the Sun is low behind or beside it.
    float rimBand = exp(-max(below, 0.0) / (isDunes() ? 1.6 : 1.0));
    float back = smoothstep(-1.0, 3.0, uSunEl) * (1.0 - smoothstep(8.0, 24.0, uSunEl));
    float rimNear = exp(-abs(fc.x - uSunPos.x) / (uSize.x * 0.15));
    lit += uSunGround * rimBand * back * rimNear * (isSea() ? 0.3 : 0.45) * shadow;

    // Moonlight (0.9.8): by the light of a high, full moon the land shows its shapes in silver-blue, from the moon's side.
    float mvis = uMoonL.z * uNight * uMoonL.w;
    if (mvis > 0.001) {
        float maz = (uMoonL.x / uSize.x - 0.5) * uFov;
        float malt = radians(uAltTop * pow(sat((uHorizon - uMoonL.y) / uHorizon), uAltPow));
        float dam = maz - az;
        float3 Lm = float3(sin(dam) * cos(malt), sin(malt), cos(dam) * cos(malt));
        float3 moonlight = float3(0.050, 0.062, 0.095) * mvis;
        lit += albedo * moonlight * (max(dot(n, Lm), 0.0) * 1.4 + 0.30) * shadow;
        lit += moonlight * rimBandMoon(below) * 0.6 * exp(-abs(fc.x - uMoonL.x) / (uSize.x * 0.3));
    }
    float3 c = tone(lit);
    // Haze: the far land takes the colour of the air at the horizon, blue light first.
    // (0.21: the higher on a mountain or a wall, the higher the air in front of it: the bluer, not the horizon's band.)
    float3 air = skyAt(fc.x, 0.6 + 2.0 * (1.0 - depth) + skyUp * rel * 10.0);
    // Under an overcast, or in rain, the air is grey.
    air = mix(air, float3(luma(air)) * float3(0.97, 0.99, 1.02), sat(uWx.x * 0.85 + uWx.z * 0.5));
    float3 k = float3(0.020, 0.026, 0.036) * (1.0 + 3.0 * uWx.z + 0.3 * uWx.x);
    float3 tr = exp(-k * dist);
    c = mix(air, c, tr);
    // Mist in the valley at the foot of this layer.
    if (uMist > 0.001 && layer < 4) {
        float drift = vnoise(float2(xd * 0.010 + uTime * 0.004, float(layer) * 4.0)) * 0.7 + 0.3 * vnoise(float2(xd * 0.035 - uTime * 0.006, float(layer)));
        float m = smoothstep(base - amp * 0.55, base + 2.0 * uDp, fc.y) * uMist * (0.45 + 0.55 * drift) * (1.0 - 0.15 * float(layer));
        m *= isForest() ? 1.3 : (isCanyon() ? 0.45 : 1.0);   // (0.19) the forest's damp air, the dry red rock
        float3 mist = mix(air, float3(1.0), 0.18 * (1.0 - uNight));
        c = mix(c, mist, sat(m) * 0.85);
    }
    return c;
}

// One layer's colour at a point, the nearest one fading into the page.
float3 layerColor(float2 fc, int i, float topY) {
    if (i < 0) return float3(0.0);  // (never: render asks for shown layers; keeps this out of render's loop, see conifers)
    float base = pick4(uBaseA, uBaseB, i);
    float amp = pick4(uAmpA, uAmpB, i);
    // Slope over a few dp: the table holds 8-bit heights, too coarse to differentiate pixel by pixel.
    float hl = landHeight(fc.x - 4.0 * uDp, i, base, amp);
    float hr = landHeight(fc.x + 4.0 * uDp, i, base, amp);
    float slope = (hl - hr) * amp / (8.0 * uDp);
    float3 c = shade(fc, i, topY, slope);
    if (i == 4) {
        // The nearest land is the page: it fades into the page colour, exactly so at the bottom edge.
        // Mixed in linear light, so a dark dune meets a light page without a muddy grey band.
        float t = smoothstep(base - amp * landHeight(fc.x, i, base, amp) + 4.0 * uDp, uSize.y - 2.0 * uDp, fc.y);
        float3 cl = pow(sat3(c), float3(2.2));
        float3 pl = pow(sat3(uPage), float3(2.2));
        c = pow(mix(mix(cl, pl, 0.22), pl, t * t * (3.0 - 2.0 * t)), float3(1.0 / 2.2));
    }
    return c;
}

float4 render(float2 fc) {
    // (0.19) Front to back, find the nearest layer that covers this pixel and the ones showing behind its edge (two
    // more at most, where skylines cross); only those are shaded (shading every layer in the loop made the program
    // five times the size of shade).
    float aa = 0.9;
    int l0 = -1; int l1 = -1; int l2 = -1;
    float c0 = 0.0; float c1 = 0.0; float c2 = 0.0; float t0 = 0.0; float t1 = 0.0; float t2 = 0.0; float a = 0.0;
    for (int i = 4; i >= 0; i--) {
        if (a < 0.995 && l2 < 0) {
            float topY = topOf(fc.x, i);
            float cov = sat((fc.y - topY) / aa + 0.5);
            if (cov > 0.0) {
                if (l0 < 0) { l0 = i; c0 = cov; t0 = topY; }
                else if (l1 < 0) { l1 = i; c1 = cov * (1.0 - a); t1 = topY; }
                else { l2 = i; c2 = cov * (1.0 - a); t2 = topY; }
                a += cov * (1.0 - a);
            }
        }
    }
    // Shaded in a loop with one call, not three calls: the GPU's driver copies a function into every place it is
    // called, and three copies of shade made the program take twice as long to prepare as 0.18's (emulator: the
    // first frame 25-40 s against 10-14 s).
    float4 acc = float4(0.0); // premultiplied
    for (int k = 0; k < 3; k++) {
        int l = k == 0 ? l0 : (k == 1 ? l1 : l2);
        if (l >= 0) acc += float4(layerColor(fc, l, k == 0 ? t0 : (k == 1 ? t1 : t2)), 1.0) * (k == 0 ? c0 : (k == 1 ? c1 : c2));
    }
    acc.rgb += (hash12(fc) - 0.5) / 255.0 * acc.a;
    return acc;
}
