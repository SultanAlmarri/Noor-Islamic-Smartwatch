<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Prayer-time notifications (Android 13+ asks the user; Noor asks only when the user turns alerts on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms at the exact minute. The user grants this in system settings; without it alerts use inexact alarms
         and Noor says so. USE_EXACT_ALARM is deliberately not requested (Google Play reserves it for clock apps). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arm alerts after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The Adhan plays from a foreground service with a visible Stop button. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the CPU awake while the Adhan plays with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <receiver android:name="com.noor.alerts.AlertReceiver" android:exported="false" />

        <receiver android:name="com.noor.alerts.SystemEventsReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.noor.alerts.AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
